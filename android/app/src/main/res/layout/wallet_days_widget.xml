<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#FFF8F5">

    <TextView
        android:id="@+id/widget_remaining_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="今月あと"
        android:textSize="12sp"
        android:textColor="#777777" />

    <TextView
        android:id="@+id/widget_remaining_budget"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="13,000円"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#222222"
        android:maxLines="1" />

    <ProgressBar
        android:id="@+id/widget_progress_bar"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="12dp"
        android:max="100"
        android:progress="0"
        android:progressTint="#FF8A65"
        android:progressBackgroundTint="#E5E0DD" />

    <TextView
        android:id="@+id/widget_usage_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="36,200円 / 50,000円"
        android:textSize="11sp"
        android:textColor="#888888" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="#EAEAEA"
        android:text="" />

    <TextView
        android:id="@+id/widget_danger_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="☕ カフェ あと1,200円"
        android:textSize="13sp"
        android:textColor="#222222"
        android:maxLines="1" />

    <TextView
        android:id="@+id/widget_danger_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="🍔 食費 あと3,400円"
        android:textSize="13sp"
        android:textColor="#222222"
        android:maxLines="1" />

</LinearLayout>